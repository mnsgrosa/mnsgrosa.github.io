---
/**
 * Theme toggle: one button, `hidden` in markup and revealed by the inline theme
 * script in `MainLayout.astro`'s `<head>`. Two states only — light and dark —
 * the stored choice wins and an absent choice follows the OS. The visible state
 * is a glyph plus a word, and `aria-pressed` carries the dark state for AT, so
 * colour is never the only carrier. No-JS keeps the button `hidden`, leaving the
 * page's automatic OS behaviour intact.
 */
import { useTranslations } from '../i18n/ui.mjs';

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<button type="button" class="theme-toggle" data-theme-toggle hidden aria-pressed="false">
  <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
  <span class="theme-toggle__label theme-toggle__label--light">{t('theme.light')}</span>
  <span class="theme-toggle__label theme-toggle__label--dark">{t('theme.dark')}</span>
</button>
