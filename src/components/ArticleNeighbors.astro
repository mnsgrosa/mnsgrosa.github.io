---
import { neighborhood } from '../lib/knowledge.mjs';
import { localePath } from '../i18n/paths.mjs';
import { useTranslations } from '../i18n/ui.mjs';
import Constellation from './Constellation.astro';

const { graph, currentId, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const { incoming, outgoing } = neighborhood(graph, currentId);
const ids = new Set([currentId, ...incoming.map(a => a.id), ...outgoing.map(a => a.id)]);
const articles = graph.articles.filter(a => ids.has(a.id));
const localGraph = {
  articles,
  subjects: graph.subjects.filter(s => articles.some(a => a.subject === s.id)).map(s => ({ ...s, count: articles.filter(a => a.subject === s.id).length })),
  edges: graph.edges.filter(edge => (edge.source === currentId || edge.target === currentId) && ids.has(edge.source) && ids.has(edge.target)),
};
---
<aside class="neighborhood" aria-labelledby="neighbors-title">
  <h2 id="neighbors-title">{t('neighbors.around')}</h2>
  <Constellation graph={localGraph} currentId={currentId} lang={lang} compact />
  <div class="neighbor-links">
    <h3>{t('neighbors.outgoing')}</h3>
    {outgoing.length ? <ul>{outgoing.map(a => <li><a href={a.url} lang={a.lang}>{a.title}</a></li>)}</ul> : <p>{t('neighbors.noOutgoing')}</p>}
    <h3>{t('neighbors.incoming')}</h3>
    {incoming.length ? <ul>{incoming.map(a => <li><a href={a.url} lang={a.lang}>{a.title}</a></li>)}</ul> : <p>{t('neighbors.noIncoming')}</p>}
    <a class="index-link" href={localePath(lang, '/#explore')}>{t('neighbors.backToMap')} ↗</a>
  </div>
</aside>
