---
const links = [
  { href: '/', label: 'About & map' },
  { href: '/posts/', label: 'Articles' },
  { href: '/experience/', label: 'Experience' },
  { href: '/projects/', label: 'Projects' },
];
const path = Astro.url.pathname;
---
<aside class="site-rail">
  <div class="rail-brand">
    <img src="/assets/pic.jpg" alt="" width="56" height="56" />
    <a href="/">Matheus Rosa</a>
  </div>
  <p class="rail-caption">Notes on data & AI</p>
  <nav aria-label="Main navigation">
    <ul>
      {links.map(link => (
        <li><a href={link.href} aria-current={(link.href === '/' ? path === '/' : path.startsWith(link.href)) ? 'page' : undefined}>{link.label}</a></li>
      ))}
    </ul>
  </nav>
</aside>
