---
const links = [
  { href: '/', label: 'Home', route: '/' },
  { href: '/#explore', label: 'Articles', route: '/posts/' },
  { href: '/#experience', label: 'Experience', route: '/experience/' },
  { href: '/#projects', label: 'Projects', route: '/projects/' },
];
const path = Astro.url.pathname;
---
<aside class="site-rail">
  <div class="rail-brand">
    <img src="/assets/pic.jpg" alt="" width="56" height="56" />
    <a href="/">Matheus Rosa</a>
  </div>
  <p class="rail-caption">Notes on data & AI</p>
  <nav aria-label="Main navigation">
    <ul>
      {links.map(link => (
        <li><a href={link.href} aria-current={(link.route === '/' ? path === '/' : path.startsWith(link.route)) ? 'page' : undefined}>{link.label}</a></li>
      ))}
    </ul>
  </nav>
</aside>
