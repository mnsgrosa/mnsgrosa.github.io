---
import { layoutGraph } from '../lib/knowledge.mjs';
import { catalogPath, explorePath } from '../i18n/paths.mjs';
import { useTranslations } from '../i18n/ui.mjs';

const { graph, currentId = '', compact = false, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const layout = layoutGraph(graph);
const current = graph.articles.find(article => article.id === currentId);
// The island the current article belongs to. The neighborhood map is a subgraph
// and draws no island node, so this is what names the way out to the whole world.
const currentSubject = current ? graph.subjects.find(subject => subject.id === current.subject) : undefined;
const key = currentId || 'world';
const catalog = catalogPath(lang);
/** Fills the `{name}` placeholders; only the language decides the word order. */
const fill = (template, values) => template.replace(/\{(\w+)\}/g, (_, name) => String(values[name] ?? ''));
// The map script runs in the browser and cannot import the dictionary, so the
// component hands it the finished strings. The `map` name keeps this block
// distinct from the scene navigator's own block, since one nests in the other.
const strings = {
  reading: t('map.reading'),
  choose: t('map.statusChoose'),
  article: t('map.statusArticle'),
  islandOne: t('map.statusIslandOne'),
  islandMany: t('map.statusIslandMany'),
  openSubject: t('map.openSubject'),
  closeSubject: t('map.closeSubject'),
  countOne: t('map.subjectCountOne'),
  countMany: t('map.subjectCountMany'),
  currentArticle: t('map.currentArticle'),
  collapsedIsland: t('map.collapsedIsland'),
  error: t('map.error'),
};
---
<knowledge-map class:list={['knowledge-map', { compact }]} data-key={key} data-current={currentId}>
  <script type="application/json" data-graph set:html={JSON.stringify(layout).replace(/</g, '\\u003c')} />
  <script type="application/json" data-i18n="map" set:html={JSON.stringify(strings).replace(/</g, '\\u003c')} />
  <div class="explorer-layout">
    <div class="map-panel">
      <div class="map-toolbar" aria-label={t('map.controlsLabel')} hidden>
        <div class="zoom-controls">
          <button type="button" data-action="out" aria-label={t('map.zoomOut')}>−</button>
          <output data-zoom aria-label={t('map.zoomLevel')}>100%</output>
          <button type="button" data-action="in" aria-label={t('map.zoomIn')}>+</button>
          <button type="button" data-action="reset">{t('map.reset')}</button>
        </div>
        <div class="pan-controls" aria-label={t('map.panLabel')}>
          <button type="button" data-action="left" aria-label={t('map.panLeft')}>←</button>
          <button type="button" data-action="up" aria-label={t('map.panUp')}>↑</button>
          <button type="button" data-action="down" aria-label={t('map.panDown')}>↓</button>
          <button type="button" data-action="right" aria-label={t('map.panRight')}>→</button>
        </div>
      </div>
      <div class="map-viewport" hidden>
        <svg class="world-svg" aria-label={compact ? t('map.labelNeighborhood') : t('map.labelWorld')}>
          <g data-camera></g>
        </svg>
      </div>
      <p class="map-fallback">{t('map.fallback')}</p>
      <p class="map-hint" hidden>{t('map.hint')}</p>
      <p class="map-status" role="status" aria-live="polite">{current ? fill(strings.reading, { title: current.title }) : strings.choose}</p>
      <div class="map-legend" hidden><span>◎ {t('map.legendSubject')}</span><span>○ {t('map.legendArticle')}</span><span>{t('map.legendEdges')}</span></div>
      {compact && currentSubject && (
        <a class="index-link map-world-link" href={explorePath(lang, currentSubject.id)}>
          {fill(t('map.openWorld'), { title: currentSubject.title })} ↗
        </a>
      )}
    </div>
    <div class="topic-index">
      <h3>{compact ? t('map.indexTitleNeighborhood') : t('map.indexTitle')}</h3>
      {!layout.subjects.length && <p>{t('map.noSubjects')} <a href={catalog}>{t('map.browseAll')}</a>.</p>}
      {layout.subjects.map(subject => (
        <section class="topic-section" data-subject-section={subject.id}>
          <h4>
            <button type="button" class="topic-toggle" data-subject={subject.id} aria-expanded="true" aria-controls={`${key.replaceAll('/', '-')}-${subject.id}`} disabled>
              <span>{subject.title}</span><span class="topic-count">{subject.count}</span>
            </button>
          </h4>
          {subject.description && <p class="topic-description">{subject.description}</p>}
          <ul class="topic-articles" id={`${key.replaceAll('/', '-')}-${subject.id}`}>
            {layout.articles.filter(article => article.subject === subject.id).map(article => (
              <li>
                <a href={article.url} aria-current={article.id === currentId ? 'page' : undefined} lang={article.lang}>
                  <span>{article.title}</span><span class="article-language">{article.lang?.toUpperCase()}</span>
                </a>
              </li>
            ))}
          </ul>
          {subject.count === 0 && <p>{t('map.emptyIsland')}</p>}
        </section>
      ))}
      {!compact && <a class="index-link" href={catalog}>{t('footer.allPosts')} ↗</a>}
    </div>
  </div>
</knowledge-map>
<script>
  import '../scripts/constellation';
</script>
