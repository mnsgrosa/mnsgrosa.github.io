---
import Sidebar from '../components/Sidebar.astro';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { isArticlePath, localeFromPathname, localePath } from '../i18n/paths.mjs';
import { useTranslations } from '../i18n/ui.mjs';
import { ogAlternateLocales, ogLocale, siteCardPath } from '../lib/og.mjs';
import { card } from '../lib/og-theme.mjs';
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/constellation.css';

// `description`, `image`, `imageAlt` and `ogType` are the only head overrides a
// page may pass. Everything else — the locales, the card, the URL — is derived
// here from the same values the page already resolved, so the link preview and
// the `hreflang` set cannot disagree.
const { title, lang, contentClass, home = false, alternates, description, image, imageAlt, ogType = 'website' } = Astro.props;
const pathname = Astro.url.pathname;
// The route is the source of truth; an article overrides it with its own
// frontmatter `lang`.
const currentLang = lang ?? localeFromPathname(pathname);
const t = useTranslations(currentLang);
const absolute = path => new URL(path, Astro.site ?? Astro.url.origin).href;
const enHref = localePath('en', pathname);
const ptHref = localePath('pt', pathname);
// A site route exists in both languages, so it points at its own twin. An
// article has one prefix-free URL per language and gets its sibling handed in
// by the page (paired through `translationKey`); its canonical stays its own URL.
const hasLocaleTwin = !isArticlePath(pathname);
const alternateLinks = alternates ?? (hasLocaleTwin
  ? [{ lang: 'en', href: enHref }, { lang: 'pt', href: ptHref }]
  : []);
const canonical = absolute(pathname);
// Metadata is a layout concern: the description and the card default here, so a
// route that passes nothing still ships a complete preview. A page overrides
// only what it actually knows better — an article's own description and card.
const metaDescription = description ?? t('site.description');
const metaImage = absolute(image ?? siteCardPath(currentLang));
const metaImageAlt = imageAlt ?? t('site.cardAlt');
const alternateLocales = ogAlternateLocales(alternateLinks, currentLang);
---
<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Theme runs before the stylesheet paints: an inline, blocking script sets
        `data-theme` on <html> from storage (or the OS when nothing is stored),
        then reveals the hidden toggle once the DOM is ready. A bundled module
        would run too late and flash the wrong palette on every dark load. */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (error) { /* storage unavailable */ }
        var dark = stored === 'dark' || (stored !== 'light' && window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches);
        root.setAttribute('data-theme', dark ? 'dark' : 'light');
        function syncChrome(isDark) {
          // The icon and the browser-chrome colour are not CSS, so they cannot be
          // switched by `[data-theme]`. Their `media` attributes are rewritten
          // here instead: `not all` disables a link outright, which is how a
          // chosen light wins on an OS that prefers dark (and the reverse).
          document.querySelectorAll('[data-theme-icon]').forEach(function (link) {
            link.media = (link.getAttribute('data-theme-icon') === (isDark ? 'dark' : 'light')) ? 'all' : 'not all';
          });
          document.querySelectorAll('[data-theme-color]').forEach(function (meta) {
            meta.media = (meta.getAttribute('data-theme-color') === (isDark ? 'dark' : 'light')) ? 'all' : 'not all';
          });
        }
        function sync() {
          var isDark = root.getAttribute('data-theme') === 'dark';
          syncChrome(isDark);
          document.querySelectorAll('[data-theme-toggle]').forEach(function (button) {
            button.hidden = false;
            button.setAttribute('aria-pressed', isDark ? 'true' : 'false');
          });
        }
        function onReady() {
          sync();
          document.querySelectorAll('[data-theme-toggle]').forEach(function (button) {
            button.addEventListener('click', function () {
              var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
              root.setAttribute('data-theme', next);
              sync();
              try { localStorage.setItem('theme', next); } catch (error) { /* storage unavailable */ }
            });
          });
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', onReady);
        else onReady();
      })();
    </script>
    {/* The icon follows the palette. The light file is declared first with no
        `media`, so a browser that ignores `media` on icon links keeps a light
        icon rather than falling through to nothing; the dark file overrides it
        only when the OS preference is dark. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" data-theme-icon="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" data-theme-icon="dark" />
    {/* Browser chrome follows too, so the tab and address bar do not stay white
        in dark mode. Values are --color-paper for each palette. */}
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" data-theme-color="light" />
    <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" data-theme-color="dark" />
    <link rel="canonical" href={canonical} />
    {alternateLinks.map(link => <link rel="alternate" hreflang={link.lang} href={absolute(link.href)} />)}
    <title>{title} · Matheus Rosa</title>
    <meta name="description" content={metaDescription} />
    <meta property="og:site_name" content="Matheus Rosa" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale(currentLang)} />
    {alternateLocales.map(locale => <meta property="og:locale:alternate" content={locale} />)}
    <meta property="og:image" content={metaImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(card.width)} />
    <meta property="og:image:height" content={String(card.height)} />
    <meta property="og:image:alt" content={metaImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={metaImage} />
    <meta name="twitter:image:alt" content={metaImageAlt} />
  </head>
  <body class:list={{ 'home-page': home }}>
    <a class="skip-link" href="#main">{t('site.skipToContent')}</a>
    {home ? (
      <header class="home-header">
        <a class="home-wordmark" href="#main" aria-label={t('site.homeLabel')}>mr<span aria-hidden="true">.</span></a>
        <div class="home-header-actions">
          <a href="#experience">{t('home.viewExperience')} <span aria-hidden="true">↓</span></a>
          <LanguageSwitch lang={currentLang} />
          <ThemeToggle lang={currentLang} />
        </div>
      </header>
    ) : <Sidebar lang={currentLang} />}
    <main class="site-main" id="main">
      <div class:list={['content', contentClass]}>
        <slot />
        <footer class:list={['site-footer', { 'home-footer': home }]}>
          {home ? (
            <>
              <div><p class="footer-name">Matheus Rosa</p><p>{t('home.tagline')}</p></div>
              <a href="mailto:matheusnsampaio@gmail.com">{t('footer.contact')} ↗</a>
              <a href="#main">{t('footer.backToTop')} ↑</a>
            </>
          ) : (
            <><span>Matheus Rosa</span><a href={localePath(currentLang, '/#explore')}>{t('footer.exploreMap')}</a><a href={localePath(currentLang, '/posts/')}>{t('footer.allPosts')}</a></>
          )}
        </footer>
      </div>
    </main>
  </body>
</html>
