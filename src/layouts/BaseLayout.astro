---
// Web fonts are self-hosted via @fontsource-variable (no external font request).
// `wght.css` is the weight-axis-only sheet: normal style, all subsets, each face
// gated by `unicode-range`, so a pt-br reader downloads only latin / latin-ext.
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/main.css';
import '../styles/menu.css';
import '../styles/images.css';
import '../styles/post_meta.css';
import '../styles/code.css';
import '../styles/tables.css';
import '../styles/misc.css';
import '../styles/tags.css';
import '../styles/home.css';
import '../styles/portfolio.css';
import { contact } from '../data/contact';

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const { title, description, isHome = false } = Astro.props;
const siteTitle = 'Matheus Rosa';
const pageTitle = isHome
  ? siteTitle
  : title
    ? `${title} | ${siteTitle}`
    : siteTitle;
---

<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta http-equiv="cache-control" content="max-age=0" />
    <meta http-equiv="cache-control" content="no-cache" />
    <meta http-equiv="expires" content="0" />
    <meta http-equiv="expires" content="Tue, 01 Jan 1980 1:00:00 GMT" />
    <meta http-equiv="pragma" content="no-cache" />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="theme-color" content="#282828" />

    <meta name="description" content={description ?? pageTitle} />

    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />

    <title>{pageTitle}</title>

    <!-- Prevent flicker on page load (Gruvbox Dark, dark only).
         This is the ONE documented exception to "no literal colour outside :root":
         the block has to be inlined in <head> so it paints before the bundled
         stylesheet lands, which means it cannot reference a custom property that
         the stylesheet defines. Keep it byte-identical to `--background` in
         src/styles/main.css. -->
    <style>
      :root {
        --background: #282828;
      }
      html {
        background-color: var(--background);
      }
      body {
        background-color: var(--background);
      }
    </style>
  </head>

  <body>
    <nav class="site-header">
      <a class="brand" href="/">Matheus Rosa</a>
      <div class="header-contact">
        <a href={contact.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={`mailto:${contact.email}`}>Email</a>
      </div>
    </nav>

    <slot />

    <br />

    <footer>
      <script is:inline>
        // Copy-to-clipboard button for code blocks (ported from hugo footer_scripts.html).
        function getTextContentRecursively(element) {
          let text = '';
          if (element.nodeType === Node.TEXT_NODE) {
            return element.textContent || '';
          }
          for (const child of element.childNodes) {
            text += getTextContentRecursively(child);
          }
          return text;
        }

        function addCopyButtonToCodeBlocks() {
          const codeBlocks = document.querySelectorAll('pre.astro-code > code');
          codeBlocks.forEach((codeBlock) => {
            const copyButton = document.createElement('button');
            copyButton.classList.add('copy-code-button');
            copyButton.innerHTML = 'copy';

            copyButton.addEventListener('click', () => {
              const codeToCopy = getTextContentRecursively(codeBlock);
              navigator.clipboard.writeText(codeToCopy);
              copyButton.innerHTML = 'copied!';
              setTimeout(() => {
                copyButton.innerHTML = 'copy';
              }, 1500);
            });

            codeBlock.parentNode.before(copyButton);
          });
        }
        setTimeout(addCopyButtonToCodeBlocks, 100);
      </script>
    </footer>
  </body>
</html>
