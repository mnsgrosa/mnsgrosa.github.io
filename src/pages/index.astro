---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sections } from '../data/sections';
import { safeGetCollection, formatDate, sortByUploadDate } from '../lib/content';

interface ListItem {
  slug: string;
  title: string;
  date?: Date;
}

// Maps entries to the light list shape, preserving the given order (callers
// are responsible for sorting).
const toItems = (
  entries: Array<{ slug: string; data: { title: string; date?: Date } }>
): ListItem[] =>
  entries.map((entry) => ({ slug: entry.slug, title: entry.data.title, date: entry.data.date }));

const listItems: Record<string, ListItem[]> = {
  portfolio: toItems(sortByUploadDate(await safeGetCollection('portfolio'))),
  posts: toItems(sortByUploadDate(await safeGetCollection('posts'))),
  estudos: toItems(
    (await safeGetCollection('estudos')).slice().sort(
      (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
    )
  ),
  diversos: toItems(sortByUploadDate(await safeGetCollection('diversos'))),
};
---

<BaseLayout isHome>
  <div class="home-content">
    <h1>Matheus Rosa</h1>
    <p>Portfolio, posts técnicos, estudos e diversos — gerados a partir de markdown.</p>
  </div>

  {
    sections.map((section) => {
      const items = section.kind === 'list' ? (listItems[section.id] ?? []) : [];
      return (
        <section>
          <h2 class="section-title">
            <a href={section.url}>{section.label}</a>
          </h2>
          <p>{section.description}</p>
          {items.length > 0 && (
            <ul class="post-list">
              {items.map((item) => (
                <li>
                  <div style="display: grid; grid-template-columns: 7em auto">
                    <span class="date">{formatDate(item.date)}</span>
                    <a href={`${section.url}${item.slug}/`}>{item.title}</a>
                  </div>
                </li>
              ))}
            </ul>
          )}
        </section>
      );
    })
  }
</BaseLayout>
