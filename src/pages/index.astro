---
import { getEntry } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import Constellation from '../components/Constellation.astro';
import { readGraph } from '../lib/content-index.mjs';
const homePage = await getEntry('pages', 'home');
const { Content } = await homePage!.render();
const graph = readGraph();
---
<MainLayout title="About & map">
  <section class="about-intro" aria-labelledby="about-title">
    <h1 id="about-title">Matheus Rosa</h1>
    <p class="about-lead">Data engineering, data science, and AI. These are my notes, connected one article at a time.</p>
    <details class="about-details">
      <summary>About my work</summary>
      <Content />
    </details>
  </section>
  <section id="explore" aria-labelledby="explore-title">
    <div class="section-intro">
      <h2 id="explore-title">Follow a thread.</h2>
      <p>Open a subject, find an article, and see where it leads. Each dot is a place to start.</p>
    </div>
    <Constellation graph={graph} />
  </section>
  <div class="home-secondary">
    <a href="/experience/">Experience ↗</a>
    <a href="/projects/">Projects ↗</a>
  </div>
</MainLayout>
