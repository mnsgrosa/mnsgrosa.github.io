---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GithubActivity from '../../components/GithubActivity.astro';
import GithubRepoCard from '../../components/widgets/GithubRepoCard.astro';
import { experience } from '../../data/experience';
import { github } from '../../data/github';
import { contact } from '../../data/contact';
---

<BaseLayout title="Portfolio">
  <section class="profile-section">
    <img class="profile-photo" src="/profile.jpg" alt="Foto de perfil de Matheus Rosa" />
    <div class="profile-info">
      <h1 class="profile-name">Matheus Rosa</h1>
      <p class="profile-bio">
        Engenheiro de aprendizado de máquina, construindo agentes, pipelines e
        ferramentas para LLMs.
      </p>
      <ul class="contact-row">
        <li>
          <a href={contact.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </li>
        <li>
          <a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </li>
        <li>
          <a href={`mailto:${contact.email}`}>Email</a>
        </li>
      </ul>
    </div>
  </section>

  <section>
    <h2 class="section-title">Experiência</h2>
    <div class="experience-grid">
      {
        experience.map((job) => (
          <article class="experience-card">
            <h3 class="experience-role">{job.role}</h3>
            <p class="experience-company">{job.company}</p>
            <p class="experience-period">{job.period}</p>
            <p class="experience-summary">{job.summary}</p>
            {
              job.stack && job.stack.length > 0 && (
                <ul class="tag-list">
                  {job.stack.map((tech) => <li class="tag-chip">{tech}</li>)}
                </ul>
              )
            }
          </article>
        ))
      }
    </div>
  </section>

  <section>
    <h2 class="section-title">Projetos</h2>
    <div class="repo-grid">
      {github.repos.map((repo) => <GithubRepoCard repo={repo} />)}
    </div>
  </section>

  <GithubActivity username={github.username} />
</BaseLayout>
